# Copy this file to .env.local, which git ignores.

# For `npm run dev`: Vite forwards /api to this API, so it needs no CORS.
# Get it with `terraform -chdir=../infra/api output -raw api_base_url`.
# RIVO_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# For a hosted build: the API's URL, written into the bundle. Set the API's
# web_origin to the site that serves the app, or the browser blocks the calls.
# VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
